{
  "name": "host",
  "private": true,
  "version": "0.2.0",
  "description": "PC host for Phone Controller",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "koffi": "^2.16.3",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.jeremiahpark.phonecontroller",
    "productName": "Phone Controller",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "electronVersion": "45.3.2",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ]
  },
  "author": "Jeremiah Park"
}
